# =============================================================================
# PlanWise AI — environment variables
# Copy to `.env` (and optionally `backend/.env`). Never commit real secrets.
#
# Where each variable belongs:
#   Frontend (Vite build) — only VITE_* keys are embedded in the browser bundle
#   Backend / Render web service — everything else (secrets stay server-side)
#
# Render: add keys to the single web service (planwise-ai). One service serves
# the API and the built React app from /dist — do not put secrets in VITE_*.
# =============================================================================

# --- Frontend (optional in production) ---------------------------------------
# Local Vite only. On Render, leave unset so the app calls same-origin `/api`.
# Required: no (production uses relative /api)
# Obtain: n/a
VITE_API_URL=http://localhost:3001/api

# --- Server ------------------------------------------------------------------
# Required on Render: yes (Render injects PORT automatically)
PORT=3001

# Public site URL for CORS + auth/email links. Must match the browser origin.
# Required on Render: yes
# Obtain: https://planwise-ai-bmj3.onrender.com (your Render URL, no trailing slash)
# Belongs: backend
CLIENT_URL=http://localhost:5180

# Render sets this automatically; used as CLIENT_URL fallback if CLIENT_URL is empty.
# Required: no
# RENDER_EXTERNAL_URL=

# --- Database (Neon Postgres) ------------------------------------------------
# Pooled connection for the running app (host usually contains "-pooler").
# Required on Render: yes
# Obtain: Neon Console → PlanWise AI → Connect → Connection pooling ON → copy
# Belongs: backend
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Direct (non-pooled) connection for Prisma db push / migrations (no "-pooler").
# Required on Render: yes (startCommand runs prisma db push)
# Obtain: Neon Console → Connect → Connection pooling OFF → copy
# Belongs: backend
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# Optional label from `neon env pull`
# Required: no
NEON_BRANCH=

# --- Auth --------------------------------------------------------------------
# Required on Render: yes (must not be the default dev value)
# Obtain: generate a long random string
# Belongs: backend
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Bootstrap admin — created only when no admin user exists yet.
# Required on Render: yes for first deploy (then optional)
# Belongs: backend
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=PlanWise Administrator

# --- AI (server-side only — never use VITE_ for these) -----------------------
# Required on Render: yes for lesson/assessment AI
# Obtain: Google AI Studio / Gemini API key
# Belongs: backend
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_PROVIDER=gemini

# Optional alternate providers
# Required: no
OPENAI_API_KEY=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4o-mini

# --- Email (optional; Render free tier blocks SMTP) --------------------------
# Without email, setup/reset still work when links/passwords are shown in the UI.
# Required: no
# Obtain: Mailjet / Brevo dashboard
# Belongs: backend
EMAIL_HTTP_PROVIDER=mailjet
MAILJET_API_KEY=
MAILJET_API_SECRET=
# EMAIL_HTTP_PROVIDER=brevo
# BREVO_API_KEY=
EMAIL_FROM="PlanWise AI <you@example.com>"

# Optional Nexus notification templates (tried before HTTP email when configured)
# Required: no
NEXUS_API_KEY=
NEXUS_BASE_URL=https://nexuszm.com/api/v1
NEXUS_LOGIN_TEMPLATE=Planwise Ai Login credentials
NEXUS_ACCOUNT_SETUP_TEMPLATE=Planwise Ai Login credentials
NEXUS_PASSWORD_RESET_TEMPLATE=password_reset
NEXUS_PASSWORD_CHANGED_TEMPLATE=password_changed

# --- Uploads -----------------------------------------------------------------
# On Render free disk is ephemeral: files disappear on redeploy. Extracted text
# for assessments is stored in Postgres (Neon) and survives redeploys.
# Required: no (defaults below)
# Belongs: backend
FILE_STORAGE_PATH=./uploads
FILE_STORAGE_URL=/uploads
MAX_UPLOAD_BYTES=15728640

# --- Billing (optional) ------------------------------------------------------
# Required: no
PAYMENT_PROVIDER=internal
# PUBLIC_API_BASE_URL=https://planwise-ai-bmj3.onrender.com
# MTN_MOMO_SUBSCRIPTION_KEY=
# MTN_MOMO_API_USER=
# MTN_MOMO_API_KEY=
# MTN_MOMO_TARGET_ENVIRONMENT=sandbox
# AIRTEL_MONEY_CLIENT_ID=
# AIRTEL_MONEY_CLIENT_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Temporary local testing only. Ignored when NODE_ENV=production.
ALLOW_UNAPPROVED_TEST_ACCOUNTS=false

# Set by Render / production hosts
# NODE_ENV=production

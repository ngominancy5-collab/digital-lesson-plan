# Choose one provider. Keys stay on the server and are never sent to the browser.

# ChatGPT / OpenAI
AI_API_KEY=your_openai_key_here
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# GitHub Copilot / GitHub Models
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4o-mini

# Optional: openai | gemini | github
AI_PROVIDER=

PORT=3001
CLIENT_URL=http://localhost:5173

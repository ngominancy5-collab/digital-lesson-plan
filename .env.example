# Shared / frontend-visible config (never put Gemini keys here for browser use)
VITE_API_URL=http://localhost:3001/api

# Server (also loaded by backend from this root file)
PORT=3001
CLIENT_URL=http://localhost:5180

# PostgreSQL
DATABASE_URL=postgresql://planwise:planwise@localhost:5432/planwise?schema=public

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# First administrator. Used only when the database has no administrator yet.
# Put the real values in planwise/.env, never in this example.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=PlanWise Administrator

# Gemini (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_PROVIDER=gemini

# Optional
OPENAI_API_KEY=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4o-mini

# Email delivery. When Nexus is not configured, account-setup, login and
# password-reset emails are sent over SMTP or an HTTP email API. Copy these into
# .env or backend/.env. The backend reads backend/.env after this file, so values
# there win.
#
# Preferred on Render's free plan: an HTTP email API (HTTPS is never blocked).
#   EMAIL_HTTP_PROVIDER=resend | brevo | sendgrid | mailjet
#   EMAIL_HTTP_API_KEY=the-provider-api-key   (Mailjet uses "APIKey:SecretKey")
#   SMTP_FROM=PlanWise AI <verified-sender@example.com>   (sender for both SMTP and HTTP)
#
# Alternative: SMTP. Required before an email can be sent: SMTP_HOST and SMTP_FROM.
# Also set SMTP_PORT, SMTP_USER, and SMTP_PASS for a normal provider.
# SMTP_SECURE=true for port 465. Leave it false for port 587/2525 and set SMTP_REQUIRE_TLS=true.
# Render FREE web services block outbound ports 25/465/587, so in production use a
# provider that offers port 2525 (e.g. SMTP2GO: mail.smtp2go.com, port 2525). Gmail
# SMTP (587/465) only works on a paid Render instance. Verify your sender with the provider.
# CLIENT_URL above is the start of the link in the email. Use the public site URL in production.
# Do not put a real password or API key in this example file.
EMAIL_HTTP_PROVIDER=
EMAIL_HTTP_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Nexus login email. Server only. Never put the real key in this example or in frontend code.
# NEXUS_LOGIN_TEMPLATE must match the template name in the Nexus dashboard exactly.
# The documented name for a new-account login email is user_created.
NEXUS_API_KEY=
NEXUS_BASE_URL=https://nexuszm.com/api/v1
NEXUS_LOGIN_TEMPLATE=user_created
NEXUS_ACCOUNT_SETUP_TEMPLATE=user_created
NEXUS_PASSWORD_RESET_TEMPLATE=password_reset

# Temporary local testing only. Leave false. Never set this in production.
# The server also ignores it when NODE_ENV=production.
ALLOW_UNAPPROVED_TEST_ACCOUNTS=false

FILE_STORAGE_PATH=./uploads
FILE_STORAGE_URL=/uploads
MAX_UPLOAD_BYTES=15728640

# Copy to backend/.env (or keep secrets in the project root .env)

# PostgreSQL connection string
# Local Docker: docker compose up -d
# Neon: pooled URL for the app; unpooled (no -pooler) for prisma db push / migrations
DATABASE_URL=postgresql://planwise:planwise@localhost:5432/planwise?schema=public
DATABASE_URL_UNPOOLED=postgresql://planwise:planwise@localhost:5432/planwise?schema=public
NEON_BRANCH=

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# First administrator. Used only when no administrator exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=PlanWise Administrator

# Gemini (server-side only — never expose to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_PROVIDER=gemini

# Optional alternate providers
OPENAI_API_KEY=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4o-mini

# Server
PORT=3001
# Public address of the React app. Reset / setup links are built from this value.
# Local: http://localhost:5180
# Production: https://your-planwise-domain
CLIENT_URL=http://localhost:5180

# Email (preferred on Render). Free-tier hosts often block outbound SMTP, so mail
# is sent over HTTPS through a provider API. Without these, account flows still
# work when Nexus is configured (below), or the API reports that email is unavailable.
# Mailjet (default provider):
# MAILJET_API_KEY=
# MAILJET_API_SECRET=
# Or switch to Brevo with EMAIL_HTTP_PROVIDER=brevo + BREVO_API_KEY=
# EMAIL_HTTP_PROVIDER=mailjet
# Verified sender address used as "From", e.g. "PlanWise AI <you@example.com>"
# EMAIL_FROM=

# Optional Nexus templates. When NEXUS_API_KEY and NEXUS_BASE_URL are set, Nexus
# is tried first; otherwise the HTTP email provider above is used.
# Put the real key in backend/.env or the project .env, never in git.
# NEXUS_LOGIN_TEMPLATE must match the saved dashboard template name exactly.
NEXUS_API_KEY=
NEXUS_BASE_URL=https://nexuszm.com/api/v1
NEXUS_LOGIN_TEMPLATE=Planwise Ai Login credentials
NEXUS_ACCOUNT_SETUP_TEMPLATE=Planwise Ai Login credentials
NEXUS_PASSWORD_RESET_TEMPLATE=password_reset
# Security notice after a successful password change. Placeholders: {{user_name}} only.
NEXUS_PASSWORD_CHANGED_TEMPLATE=password_changed

# Temporary local testing only. Leave false. Ignored when NODE_ENV=production.
ALLOW_UNAPPROVED_TEST_ACCOUNTS=false

FILE_STORAGE_PATH=./uploads
FILE_STORAGE_URL=/uploads
MAX_UPLOAD_BYTES=15728640

# Copy to backend/.env (or keep secrets in the project root .env)

# PostgreSQL connection string
# Local Docker: docker compose up -d
DATABASE_URL=postgresql://planwise:planwise@localhost:5432/planwise?schema=public

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# First administrator. Used only when no administrator exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=PlanWise Administrator

# Gemini (server-side only — never expose to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_PROVIDER=gemini

# Optional alternate providers
OPENAI_API_KEY=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4o-mini

# Server
PORT=3001
# Public address of the React app. Reset links are built from this value.
# Local: http://localhost:5180
# Production: https://your-planwise-domain
CLIENT_URL=http://localhost:5180

# Email delivery. When Nexus is not configured, the API sends account-setup,
# login and password-reset emails over an HTTP email API or SMTP. Put these in
# backend/.env locally, and in the host's environment settings in production.
# Never commit real passwords or API keys. If nothing below (and no Nexus) is set,
# the API says email is not configured instead of claiming a link was sent.
#
# Option 1 (preferred on Render's free plan) — HTTP email API over HTTPS:
#   EMAIL_HTTP_PROVIDER=resend | brevo | sendgrid | mailjet
#   EMAIL_HTTP_API_KEY=the-provider-api-key   (Mailjet uses "APIKey:SecretKey")
#   SMTP_FROM=PlanWise AI <verified-sender@example.com>
#
# Option 2 — SMTP. Example for Gmail or Google Workspace (use an app password, not
# the account password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_REQUIRE_TLS=true
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=the-app-password-from-your-provider
#   SMTP_FROM="PlanWise AI <you@gmail.com>"
#
# Render FREE web services block outbound ports 25, 465 and 587. In production use a
# provider that offers port 2525 instead (e.g. SMTP2GO: host mail.smtp2go.com, port 2525,
# STARTTLS). Gmail SMTP only works on a paid Render instance. Verify your sender first.
#
# Port 465 usually needs SMTP_SECURE=true. Port 587/2525 use STARTTLS with SMTP_SECURE=false.
EMAIL_HTTP_PROVIDER=
EMAIL_HTTP_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional. Nexus sends these emails when configured; SMTP is used otherwise.
# If both are set, Nexus wins. Leave blank to use SMTP only.
# Nexus login email. Put the real key in backend/.env or the project .env, never in git.
# NEXUS_LOGIN_TEMPLATE must match the saved dashboard template name. Default: user_created.
NEXUS_API_KEY=
NEXUS_BASE_URL=https://nexuszm.com/api/v1
NEXUS_LOGIN_TEMPLATE=user_created
NEXUS_ACCOUNT_SETUP_TEMPLATE=user_created
NEXUS_PASSWORD_RESET_TEMPLATE=password_reset

# Temporary local testing only. Leave false. Ignored when NODE_ENV=production.
ALLOW_UNAPPROVED_TEST_ACCOUNTS=false

FILE_STORAGE_PATH=./uploads
FILE_STORAGE_URL=/uploads
MAX_UPLOAD_BYTES=15728640

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  teacher
  lecturer
  admin
  student
  coordinator
}

enum DocumentStatus {
  pending
  processing
  ready
  failed
}

enum DifficultyLevel {
  Easy
  Intermediate
  Advanced
  Professional
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(lecturer)
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile              UserProfile?
  passwordResetTokens  PasswordResetToken[]
  documents            Document[]
  lessonPlans          LessonPlan[]
  quizzes              Quiz[]
  assessments          Assessment[]
  calendarEvents       CalendarEvent[]
  conversations        AiConversation[]
  courses                 Course[]
  attendanceRecords       Attendance[]
  markedPapers            MarkedPaper[]
  notifications           Notification[]
  notificationPreference  NotificationPreference?

  @@index([email])
}

model UserProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  institution      String?
  department       String?
  specialization   String?
  educationLevel   String?
  phone            String?
  preferences      Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model Document {
  id              String         @id @default(cuid())
  userId          String
  originalName    String
  fileType        String
  fileSize        Int
  storagePath     String
  storageUrl      String?
  status          DocumentStatus @default(pending)
  extractedText   String?        @db.Text
  errorMessage    String?
  courseName      String?
  courseCode      String?
  description     String?        @db.Text
  topics          Json           @default("[]")
  objectives      Json           @default("[]")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonPlans LessonPlan[]

  @@index([userId])
}

model Course {
  id          String   @id @default(cuid())
  userId      String
  name        String
  code        String?
  description String?  @db.Text
  fileName    String?
  semester    String?
  duration    String?
  startDate   String?
  endDate     String?
  modules     Json     @default("[]")
  meta        Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LessonPlan {
  id                 String          @id @default(cuid())
  userId             String
  title              String
  subject            String?
  topic              String?
  gradeLevel         String?
  duration           String?
  learningObjectives Json            @default("[]")
  introduction       String?         @db.Text
  lessonActivities   Json            @default("[]")
  teachingMethods    Json            @default("[]")
  requiredMaterials  Json            @default("[]")
  assessmentMethod   String?         @db.Text
  conclusion         String?         @db.Text
  difficulty         DifficultyLevel @default(Intermediate)
  sourceDocumentId   String?
  aiGenerated        Boolean         @default(false)
  status             String          @default("draft")
  courseName         String?
  courseCode         String?
  lessons            Json            @default("[]")
  warnings           Json            @default("[]")
  meta               Json            @default("{}")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDocument Document?       @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  quizzes        Quiz[]
  assessments    Assessment[]
  calendarEvents CalendarEvent[]

  @@index([userId])
  @@index([sourceDocumentId])
}

model Quiz {
  id           String          @id @default(cuid())
  userId       String
  lessonPlanId String?
  title        String
  instructions String?         @db.Text
  difficulty   DifficultyLevel @default(Intermediate)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonPlan LessonPlan?   @relation(fields: [lessonPlanId], references: [id], onDelete: SetNull)
  questions  QuizQuestion[]

  @@index([userId])
  @@index([lessonPlanId])
}

model QuizQuestion {
  id            String @id @default(cuid())
  quizId        String
  question      String @db.Text
  questionType  String
  marks         Int    @default(1)
  correctAnswer String? @db.Text
  sortOrder     Int    @default(0)

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]

  @@index([quizId])
}

model QuizOption {
  id         String @id @default(cuid())
  questionId String
  optionText String
  optionLabel String?
  isCorrect  Boolean @default(false)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Assessment {
  id           String   @id @default(cuid())
  userId       String
  lessonPlanId String?
  title        String
  description  String?  @db.Text
  type         String   @default("quiz")
  instructions String?  @db.Text
  marks        Int?
  dueDate      DateTime?
  status       String   @default("draft")
  questions    Json     @default("[]")
  meta         Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonPlan LessonPlan? @relation(fields: [lessonPlanId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([lessonPlanId])
}

model CalendarEvent {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String?  @db.Text
  eventType    String   @default("lesson")
  startAt      DateTime
  endAt        DateTime?
  date         String?
  startTime    String?
  endTime      String?
  status       String   @default("confirmed")
  source       String   @default("manual")
  lessonPlanId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonPlan LessonPlan? @relation(fields: [lessonPlanId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([startAt])
  @@index([lessonPlanId])
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New conversation")
  meta      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId])
}

model Institution {
  id        String   @id @default(cuid())
  name      String
  type      String
  createdAt DateTime @default(now())

  @@unique([name, type])
  @@index([type])
}

model Attendance {
  id            String    @id @default(cuid())
  userId        String
  date          String
  clockIn       DateTime
  clockOut      DateTime?
  status        String    @default("open")
  workedMinutes Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, status])
}

model MarkedPaper {
  id             String   @id @default(cuid())
  userId         String
  studentName    String
  assessmentName String
  score          Float?
  totalMarks     Float?
  percentage     Float?
  questions      Json     @default("[]")
  feedback       String?  @db.Text
  markedAt       DateTime @default(now())
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("system")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model NotificationPreference {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  emailNotifications       Boolean  @default(true)
  lessonPlanNotifications  Boolean  @default(true)
  assessmentNotifications  Boolean  @default(true)
  calendarNotifications    Boolean  @default(true)
  systemNotifications      Boolean  @default(true)
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  sender         String
  message        String   @db.Text
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

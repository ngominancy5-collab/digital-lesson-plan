generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  teacher
  lecturer
  admin
  student
  coordinator
  unassigned
}

enum DocumentStatus {
  pending
  processing
  ready
  failed
}

enum DifficultyLevel {
  Easy
  Intermediate
  Advanced
  Professional
}

enum AccountStatus {
  pending
  approved
  rejected
  suspended
  inactive
}

enum EmailDeliveryStatus {
  none
  pending
  accepted
  failed
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  username     String?  @unique
  email        String   @unique
  emailVerified Boolean @default(false)
  passwordHash String
  role                UserRole      @default(lecturer)
  requestedRole       UserRole?
  accountStatus       AccountStatus @default(approved)
  mustChangePassword  Boolean       @default(false)
  roleConfirmed       Boolean       @default(true)
  approvedAt          DateTime?
  approvedById        String?
  profileImage        String?
  lastLoginAt         DateTime?
  credentialEmailStatus     EmailDeliveryStatus @default(none)
  credentialEmailSentAt     DateTime?
  confirmationEmailStatus   EmailDeliveryStatus @default(none)
  confirmationEmailSentAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile              UserProfile?
  passwordResetTokens  PasswordResetToken[]
  documents            Document[]
  lessonPlans          LessonPlan[]
  quizzes              Quiz[]
  assessments          Assessment[]
  calendarEvents       CalendarEvent[]
  conversations        AiConversation[]
  courses                 Course[]
  attendanceRecords       Attendance[]
  markedPapers            MarkedPaper[]
  notifications           Notification[]
  notificationPreference  NotificationPreference?
  activities              ActivityLog[]
  subscription            UserSubscription?
  usagePeriods            UsagePeriod[]
  billingTransactions     BillingTransaction[]

  @@index([email])
}

enum PlanInterval {
  none
  monthly
  yearly
}

enum SubscriptionStatus {
  free
  active
  past_due
  canceled
  incomplete
  payment_pending
  expired
}

enum BillingStatus {
  pending
  paid
  failed
  refunded
  cancelled
  expired
}

/// Website CMS image metadata (files live in FILE_STORAGE_PATH).
model SiteImage {
  id          String   @id @default(cuid())
  sectionKey  String
  title       String   @default("")
  altText     String   @default("")
  storagePath String
  storageUrl  String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sectionKey, isActive, sortOrder])
}

model SubscriptionPlan {
  id            String       @id @default(cuid())
  code          String       @unique
  name          String
  description   String       @default("")
  interval      PlanInterval @default(none)
  priceCents    Int          @default(0)
  currency      String       @default("ZMW")
  aiPromptLimit Int          @default(25)
  uploadLimit   Int          @default(10)
  isActive      Boolean      @default(true)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  subscriptions UserSubscription[]
  transactions  BillingTransaction[]
}

model UserSubscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  planId                 String
  status                 SubscriptionStatus @default(free)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  provider               String             @default("internal")
  providerCustomerId     String?
  providerSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan     @relation(fields: [planId], references: [id])
  transactions BillingTransaction[]

  @@index([planId])
  @@index([status])
}

model UsagePeriod {
  id            String   @id @default(cuid())
  userId        String
  periodKey     String
  aiPromptCount Int      @default(0)
  uploadCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodKey])
  @@index([userId])
}

model BillingTransaction {
  id             String        @id @default(cuid())
  userId         String
  subscriptionId String?
  planId         String?
  amountCents    Int
  currency       String        @default("ZMW")
  status         BillingStatus @default(pending)
  provider       String        @default("mtn")
  paymentMethod  String?
  msisdn         String?
  providerRef    String?
  checkoutToken  String?       @unique
  callbackSecret String?
  meta           Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription UserSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
  @@index([providerRef])
  @@index([paymentMethod])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  actorRole  String   @default("")
  type       String
  summary    String
  targetType String   @default("")
  targetId   String   @default("")
  outcome    String   @default("success")
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([type])
  @@index([userId])
  @@index([outcome])
}

model UserProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  institution      String?
  department       String?
  specialization   String?
  educationLevel   String?
  phone            String?
  preferences      Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model Document {
  id              String         @id @default(cuid())
  userId          String
  originalName    String
  fileType        String
  fileSize        Int
  storagePath     String
  storageUrl      String?
  status          DocumentStatus @default(pending)
  extractedText   String?        @db.Text
  errorMessage    String?
  courseName      String?
  courseCode      String?
  description     String?        @db.Text
  topics          Json           @default("[]")
  objectives      Json           @default("[]")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonPlans LessonPlan[]

  @@index([userId])
}

model Course {
  id          String   @id @default(cuid())
  userId      String
  name        String
  code        String?
  description String?  @db.Text
  fileName    String?
  semester    String?
  duration    String?
  startDate   String?
  endDate     String?
  modules     Json     @default("[]")
  meta        Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LessonPlan {
  id                 String          @id @default(cuid())
  userId             String
  title              String
  subject            String?
  topic              String?
  gradeLevel         String?
  duration           String?
  learningObjectives Json            @default("[]")
  introduction       String?         @db.Text
  lessonActivities   Json            @default("[]")
  teachingMethods    Json            @default("[]")
  requiredMaterials  Json            @default("[]")
  assessmentMethod   String?         @db.Text
  conclusion         String?         @db.Text
  difficulty         DifficultyLevel @default(Intermediate)
  sourceDocumentId   String?
  aiGenerated        Boolean         @default(false)
  status             String          @default("draft")
  courseName         String?
  courseCode         String?
  lessons            Json            @default("[]")
  warnings           Json            @default("[]")
  meta               Json            @default("{}")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDocument Document?       @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  quizzes        Quiz[]
  assessments    Assessment[]
  calendarEvents CalendarEvent[]

  @@index([userId])
  @@index([sourceDocumentId])
}

model Quiz {
  id           String          @id @default(cuid())
  userId       String
  lessonPlanId String?
  title        String
  instructions String?         @db.Text
  difficulty   DifficultyLevel @default(Intermediate)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonPlan LessonPlan?   @relation(fields: [lessonPlanId], references: [id], onDelete: SetNull)
  questions  QuizQuestion[]

  @@index([userId])
  @@index([lessonPlanId])
}

model QuizQuestion {
  id            String @id @default(cuid())
  quizId        String
  question      String @db.Text
  questionType  String
  marks         Int    @default(1)
  correctAnswer String? @db.Text
  sortOrder     Int    @default(0)

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]

  @@index([quizId])
}

model QuizOption {
  id         String @id @default(cuid())
  questionId String
  optionText String
  optionLabel String?
  isCorrect  Boolean @default(false)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Assessment {
  id           String   @id @default(cuid())
  userId       String
  lessonPlanId String?
  title        String
  description  String?  @db.Text
  type         String   @default("quiz")
  instructions String?  @db.Text
  marks        Int?
  dueDate      DateTime?
  status       String   @default("draft")
  questions    Json     @default("[]")
  meta         Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonPlan LessonPlan? @relation(fields: [lessonPlanId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([lessonPlanId])
}

model CalendarEvent {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String?  @db.Text
  eventType    String   @default("lesson")
  startAt      DateTime
  endAt        DateTime?
  date         String?
  startTime    String?
  endTime      String?
  status       String   @default("confirmed")
  source       String   @default("manual")
  lessonPlanId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonPlan LessonPlan? @relation(fields: [lessonPlanId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([startAt])
  @@index([lessonPlanId])
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New conversation")
  meta      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId])
}

model Institution {
  id        String   @id @default(cuid())
  name      String
  type      String
  createdAt DateTime @default(now())

  @@unique([name, type])
  @@index([type])
}

model Attendance {
  id            String    @id @default(cuid())
  userId        String
  date          String
  clockIn       DateTime
  clockOut      DateTime?
  status        String    @default("open")
  workedMinutes Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, status])
}

model MarkedPaper {
  id             String    @id @default(cuid())
  userId         String
  studentName    String
  assessmentName String
  /// Teacher/lecturer final score (source of truth once reviewed).
  score          Float?
  totalMarks     Float?
  percentage     Float?
  /// Frozen AI totals for comparison.
  aiScore        Float?
  aiTotalMarks   Float?
  aiPercentage   Float?
  /// Current question marks (teacher-editable). Includes AI suggestion fields per item.
  questions      Json      @default("[]")
  /// Immutable snapshot of AI-suggested questions at first mark.
  aiQuestions    Json      @default("[]")
  feedback       String?   @db.Text
  aiFeedback     String?   @db.Text
  /// ai_completed | under_review | draft | finalized
  reviewStatus   String    @default("ai_completed")
  reviewedAt     DateTime?
  finalizedAt    DateTime?
  lastSavedAt    DateTime?
  /// Soft-delete / archive timestamp. Finalized papers are archived, not hard-deleted.
  deletedAt      DateTime?
  markedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, reviewStatus])
  @@index([userId, deletedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("system")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model NotificationPreference {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  emailNotifications       Boolean  @default(true)
  lessonPlanNotifications  Boolean  @default(true)
  assessmentNotifications  Boolean  @default(true)
  calendarNotifications    Boolean  @default(true)
  systemNotifications      Boolean  @default(true)
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  sender         String
  message        String   @db.Text
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
